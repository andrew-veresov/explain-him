{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrew-veresov.github.io/explain-him/schemas/webmcp-apply.v3.schema.json",
  "title": "Explain Him WebMCP Protocol v3 apply handshake",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "expectedWorkspaceRevision", "explanationId", "topicId", "operations", "handshake"],
  "properties": {
    "requestId": {"$ref": "#/$defs/string"},
    "expectedWorkspaceRevision": {"type": "integer", "minimum": 0},
    "explanationId": {"$ref": "#/$defs/string"},
    "topicId": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"oneOf": [{"$ref": "#/$defs/add"}, {"$ref": "#/$defs/replace"}, {"$ref": "#/$defs/update"}, {"$ref": "#/$defs/remove"}, {"$ref": "#/$defs/focus"}]}},
    "handshake": {"$ref": "#/$defs/handshake"}
  },
  "$defs": {
    "string": {"type": "string", "minLength": 1, "maxLength": 160},
    "localId": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^local-[A-Za-z0-9._:-]+$"},
    "targetId": {"type": "string", "minLength": 1, "maxLength": 120},
    "source": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"repository": {"type": "string", "minLength": 1, "maxLength": 200}, "path": {"type": "string", "minLength": 1, "maxLength": 500}, "ref": {"type": "string", "minLength": 1, "maxLength": 160}, "section": {"type": "string", "minLength": 1, "maxLength": 300}, "status": {"type": "string", "minLength": 1, "maxLength": 40}}},
    "sources": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/source"}},
    "callout": {"type": "object", "additionalProperties": false, "required": ["type", "title", "body"], "properties": {"type": {"const": "callout"}, "title": {"$ref": "#/$defs/string"}, "body": {"type": "string", "minLength": 1, "maxLength": 5000}, "tone": {"enum": ["neutral", "example", "warning", "insight"]}, "sources": {"$ref": "#/$defs/sources"}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["type", "title", "columns"], "properties": {"type": {"const": "comparison"}, "title": {"$ref": "#/$defs/string"}, "columns": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["title", "items"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 120}, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}}}}}, "sources": {"$ref": "#/$defs/sources"}}},
    "workflow": {"type": "object", "additionalProperties": false, "required": ["type", "title", "steps"], "properties": {"type": {"const": "workflow"}, "title": {"$ref": "#/$defs/string"}, "steps": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 120}, "body": {"type": "string", "minLength": 1, "maxLength": 800}}}}, "sources": {"$ref": "#/$defs/sources"}}},
    "timeline": {"type": "object", "additionalProperties": false, "required": ["type", "title", "items"], "properties": {"type": {"const": "timeline"}, "title": {"$ref": "#/$defs/string"}, "items": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["label", "body"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 100}, "body": {"type": "string", "minLength": 1, "maxLength": 800}}}}, "sources": {"$ref": "#/$defs/sources"}}},
    "diagram": {"type": "object", "additionalProperties": false, "required": ["type", "title", "nodes"], "properties": {"type": {"const": "diagram"}, "title": {"$ref": "#/$defs/string"}, "variant": {"enum": ["concept", "architecture", "sequence", "flow"]}, "nodes": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 80}, "label": {"type": "string", "minLength": 1, "maxLength": 140}, "body": {"type": "string", "minLength": 1, "maxLength": 600}}}}, "edges": {"type": "array", "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "minLength": 1, "maxLength": 80}, "to": {"type": "string", "minLength": 1, "maxLength": 80}, "label": {"type": "string", "minLength": 1, "maxLength": 120}}}}, "sources": {"$ref": "#/$defs/sources"}}},
    "block": {"oneOf": [{"$ref": "#/$defs/callout"}, {"$ref": "#/$defs/comparison"}, {"$ref": "#/$defs/workflow"}, {"$ref": "#/$defs/timeline"}, {"$ref": "#/$defs/diagram"}]},
    "add": {"type": "object", "additionalProperties": false, "required": ["op", "targetId", "block"], "properties": {"op": {"const": "add"}, "targetId": {"$ref": "#/$defs/targetId"}, "blockId": {"$ref": "#/$defs/localId"}, "block": {"$ref": "#/$defs/block"}}},
    "replace": {"type": "object", "additionalProperties": false, "required": ["op", "targetId", "block"], "properties": {"op": {"const": "replace"}, "targetId": {"$ref": "#/$defs/targetId"}, "blockId": {"$ref": "#/$defs/localId"}, "block": {"$ref": "#/$defs/block"}}},
    "update": {"type": "object", "additionalProperties": false, "required": ["op", "blockId", "block"], "properties": {"op": {"const": "update"}, "blockId": {"$ref": "#/$defs/localId"}, "block": {"$ref": "#/$defs/block"}}},
    "remove": {"type": "object", "additionalProperties": false, "required": ["op", "blockId"], "properties": {"op": {"const": "remove"}, "blockId": {"$ref": "#/$defs/localId"}}},
    "focus": {"type": "object", "additionalProperties": false, "oneOf": [{"required": ["op", "targetId"]}, {"required": ["op", "blockId"]}], "properties": {"op": {"const": "focus"}, "targetId": {"$ref": "#/$defs/targetId"}, "blockId": {"$ref": "#/$defs/localId"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["id", "commit", "sha256"], "properties": {"id": {"type": "string", "enum": ["explain-him", "explain-him-presentation"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "handshake": {"type": "object", "additionalProperties": false, "required": ["contractId", "activationId", "nonce", "baseRevision", "skillProof"], "properties": {"contractId": {"type": "string", "pattern": "^contract-[0-9a-f]{36}$"}, "activationId": {"type": "string", "pattern": "^activation-[0-9a-f]{36}$"}, "nonce": {"type": "string", "pattern": "^nonce-[0-9a-f]{36}$"}, "baseRevision": {"$ref": "#/$defs/string"}, "skillProof": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/proof"}}}}
  }
}
