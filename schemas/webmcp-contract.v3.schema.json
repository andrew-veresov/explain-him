{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrew-veresov.github.io/explain-him/schemas/webmcp-contract.v3.schema.json",
  "title": "Explain Him WebMCP Protocol v3 contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "bootstrapTool", "answerWorkflow", "toolUsage", "activation", "contractId", "explanationId", "baseRevision", "workspaceRevision", "repository", "skills", "skillLoadOrder", "skillProof", "skillDelivery", "groundingSourceIndex", "agentPolicy", "blockSchema", "handshakeSchema", "targets", "localBlocks", "applyOperations", "authoredLayerMutable", "repositoryAccessViaWebMcp"],
  "properties": {
    "schemaVersion": {"const": "explain-him-webmcp-contract.v3"},
    "protocolVersion": {"const": 3},
    "bootstrapTool": {"const": "get_explain_him_answer"},
    "answerWorkflow": {"$ref": "#/$defs/answerWorkflow"},
    "toolUsage": {"$ref": "#/$defs/toolUsage"},
    "activation": {"$ref": "#/$defs/activation"},
    "contractId": {"$ref": "#/$defs/contractId"},
    "explanationId": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "baseRevision": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "workspaceRevision": {"type": "integer", "minimum": 0},
    "repository": {"$ref": "#/$defs/repository"},
    "skills": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/groundingSkill"}, {"$ref": "#/$defs/presentationSkill"}], "items": false},
    "skillLoadOrder": {"const": ["explain-him", "explain-him-presentation"]},
    "skillProof": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/groundingProof"}, {"$ref": "#/$defs/presentationProof"}], "items": false},
    "skillDelivery": {"$ref": "#/$defs/skillDelivery"},
    "groundingSourceIndex": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/originatorPublishingSource"}, {"$ref": "#/$defs/originatorPublishingContractSource"}], "items": false},
    "agentPolicy": {"$ref": "#/$defs/agentPolicy"},
    "blockSchema": {"$ref": "#/$defs/schemaLocation"},
    "handshakeSchema": {"$ref": "#/$defs/schemaLocation"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "localBlocks": {"type": "array", "items": {"$ref": "#/$defs/localBlock"}},
    "applyOperations": {"const": ["add", "replace", "update", "remove", "focus"]},
    "authoredLayerMutable": {"const": false},
    "repositoryAccessViaWebMcp": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160},
    "contractId": {"type": "string", "pattern": "^contract-[0-9a-f]{36}$"},
    "activation": {"type": "object", "additionalProperties": false, "required": ["id", "nonce"], "properties": {"id": {"type": "string", "pattern": "^activation-[0-9a-f]{36}$"}, "nonce": {"type": "string", "pattern": "^nonce-[0-9a-f]{36}$"}}},
    "workflowStep": {"type": "object", "additionalProperties": false, "required": ["order", "id", "action"], "properties": {"order": {"type": "integer", "minimum": 1}, "id": {"type": "string", "minLength": 1, "maxLength": 80}, "action": {"type": "string", "minLength": 1, "maxLength": 800}}},
    "answerWorkflow": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "requiredBeforeAnyExplainHimAnswer", "steps"], "properties": {"schemaVersion": {"const": "explain-him-answer-workflow.v1"}, "requiredBeforeAnyExplainHimAnswer": {"const": true}, "steps": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/workflowStep"}}}},
    "toolUsage": {"type": "object", "additionalProperties": false, "required": ["get_explain_him_answer", "apply_explanation"], "properties": {"get_explain_him_answer": {"type": "object", "additionalProperties": false, "required": ["readOnly", "when", "returns"], "properties": {"readOnly": {"const": true}, "when": {"type": "string", "minLength": 1}, "returns": {"type": "string", "minLength": 1}}}, "apply_explanation": {"type": "object", "additionalProperties": false, "required": ["readOnly", "when", "effects"], "properties": {"readOnly": {"const": false}, "when": {"type": "string", "minLength": 1}, "effects": {"type": "string", "minLength": 1}}}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["fullName", "url", "skillsCommit"], "properties": {"fullName": {"const": "andrew-veresov/explain-him"}, "url": {"const": "https://github.com/andrew-veresov/explain-him"}, "skillsCommit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}}},
    "groundingProof": {"type": "object", "additionalProperties": false, "required": ["id", "commit", "sha256"], "properties": {"id": {"const": "explain-him"}, "commit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sha256": {"const": "b274b2125d2b3f11ded65a9fef26406c8d973333d3e9df88718dba6f22e1becb"}}},
    "presentationProof": {"type": "object", "additionalProperties": false, "required": ["id", "commit", "sha256"], "properties": {"id": {"const": "explain-him-presentation"}, "commit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sha256": {"const": "a51bea92203f037402f3feb3e605072d63c30ddf7e9a88426eb1909d2b26382a"}}},
    "deliveryProof": {"type": "object", "additionalProperties": false, "required": ["mode", "deliveryId", "registrationId", "compositeSha256", "sourceCommit", "sourceProof"], "properties": {"mode": {"enum": ["native-inline", "pinned-remote-fallback"]}, "deliveryId": {"type": "string", "pattern": "^delivery-[0-9a-f]{36}$"}, "registrationId": {"type": ["string", "null"], "pattern": "^skill-registration-[0-9a-f]{36}$"}, "compositeSha256": {"const": "e711414af844c93959bd2632846baf8e910685d72a858e31bdb90e03c050b123"}, "sourceCommit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sourceProof": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/groundingProof"}, {"$ref": "#/$defs/presentationProof"}], "items": false}}},
    "skillDelivery": {"type": "object", "additionalProperties": false, "required": ["mode", "proposalStatus", "nativeRegistrationState", "remoteVerificationRequiredForApply", "proof"], "properties": {"mode": {"enum": ["native-inline", "pinned-remote-fallback"]}, "proposalStatus": {"const": "experimental-open-backlog"}, "nativeRegistrationState": {"enum": ["registered", "unavailable", "error", "pending", "blocked-tools"]}, "remoteVerificationRequiredForApply": {"type": "boolean"}, "proof": {"$ref": "#/$defs/deliveryProof"}}},
    "groundingSkill": {"type": "object", "additionalProperties": false, "required": ["id", "path", "rawUrl", "commit", "sha256", "responsibility"], "properties": {"id": {"const": "explain-him"}, "path": {"const": "skills/explain-him/SKILL.md"}, "rawUrl": {"const": "https://raw.githubusercontent.com/andrew-veresov/explain-him/ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625/skills/explain-him/SKILL.md"}, "commit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sha256": {"const": "b274b2125d2b3f11ded65a9fef26406c8d973333d3e9df88718dba6f22e1becb"}, "responsibility": {"const": "grounding-and-repository-retrieval"}}},
    "presentationSkill": {"type": "object", "additionalProperties": false, "required": ["id", "path", "rawUrl", "commit", "sha256", "responsibility"], "properties": {"id": {"const": "explain-him-presentation"}, "path": {"const": "skills/explain-him-presentation/SKILL.md"}, "rawUrl": {"const": "https://raw.githubusercontent.com/andrew-veresov/explain-him/ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625/skills/explain-him-presentation/SKILL.md"}, "commit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sha256": {"const": "a51bea92203f037402f3feb3e605072d63c30ddf7e9a88426eb1909d2b26382a"}, "responsibility": {"const": "typed-page-presentation-and-guided-focus"}}},
    "originatorPublishingSource": {"type": "object", "additionalProperties": false, "required": ["topic", "path", "section", "status", "rawUrl", "commit", "sha256"], "properties": {"topic": {"const": "originator-publishing"}, "path": {"const": "knowledge/01-originator-flow.md"}, "section": {"const": "Basic flow"}, "status": {"const": "current"}, "rawUrl": {"const": "https://raw.githubusercontent.com/andrew-veresov/explain-him/ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625/knowledge/01-originator-flow.md"}, "commit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sha256": {"const": "cf7a396231a50a18c37a9c52ddc7c7315c07cf4107b6dea524760eaa630f3659"}}},
    "originatorPublishingContractSource": {"type": "object", "additionalProperties": false, "required": ["topic", "path", "section", "status", "rawUrl", "commit", "sha256"], "properties": {"topic": {"const": "originator-publishing"}, "path": {"const": "PRODUCT-CONTRACT.md"}, "section": {"const": "Authoring and publishing reality"}, "status": {"const": "current"}, "rawUrl": {"const": "https://raw.githubusercontent.com/andrew-veresov/explain-him/ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625/PRODUCT-CONTRACT.md"}, "commit": {"const": "ea51b6bbc1f6f863e1f87d5584da3feb1c9b8625"}, "sha256": {"const": "fc3ae6e6dd4d09183ecde12c9a25506a34c969dd6a7ea4ead181990ab2b3a2dd"}}},
    "schemaLocation": {"type": "object", "additionalProperties": false, "required": ["path", "url"], "properties": {"path": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._/-]+\\.json$"}, "url": {"type": "string", "pattern": "^/explain-him/schemas/[A-Za-z0-9._/-]+\\.json$"}, "types": {"type": "array", "items": {"enum": ["callout", "comparison", "workflow", "timeline", "diagram"]}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["id", "title", "replaceable", "acceptedTypes"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string", "maxLength": 120}, "replaceable": {"type": "boolean"}, "acceptedTypes": {"const": ["callout", "comparison", "workflow", "timeline", "diagram"]}}},
    "localBlock": {"type": "object", "additionalProperties": false, "required": ["id", "topicId", "targetId", "placement", "type", "title", "updatedAt"], "properties": {"id": {"type": "string", "pattern": "^local-[A-Za-z0-9._:-]+$"}, "topicId": {"type": ["string", "null"], "maxLength": 120}, "targetId": {"$ref": "#/$defs/identifier"}, "placement": {"enum": ["after", "replace"]}, "type": {"type": ["string", "null"], "enum": ["callout", "comparison", "workflow", "timeline", "diagram", null]}, "title": {"type": ["string", "null"], "maxLength": 160}, "updatedAt": {"type": ["string", "null"]}}},
    "agentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "bootstrap", "skillLoading", "repositoryRetrievalRequiredWhenPageInsufficient", "decisionPrecedence", "terminologyConsistency", "presentationDecision", "continuation", "failure", "applyHandshake"],
      "properties": {
        "revision": {"const": "A7"},
        "bootstrap": {"type": "object", "additionalProperties": false, "required": ["tool", "requiredOnPageActivation", "beforeAnyExplainHimAnswer"], "properties": {"tool": {"const": "get_explain_him_answer"}, "requiredOnPageActivation": {"const": true}, "beforeAnyExplainHimAnswer": {"const": true}}},
        "skillLoading": {"type": "object", "additionalProperties": false, "required": ["required", "loadOrder", "deliveryModes", "nativeRegistrationDoesNotProveSemanticReading"], "properties": {"required": {"const": true}, "loadOrder": {"const": ["explain-him", "explain-him-presentation"]}, "deliveryModes": {"const": ["native-inline", "pinned-remote-fallback"]}, "nativeRegistrationDoesNotProveSemanticReading": {"const": true}}},
        "repositoryRetrievalRequiredWhenPageInsufficient": {"const": true},
        "decisionPrecedence": {"const": ["explicitNoPageChange", "restore", "terminologyConsistency", "answerPresence"]},
        "terminologyConsistency": {"type": "object", "additionalProperties": false, "required": ["equivalentLabels", "equivalenceNoteDoesNotMakeMixedLabelsConsistent", "questionTriggersSameTurnNormalization", "defaultTerm", "distinctRoles", "firstCorrection", "sameTopicFollowUp", "restore"], "properties": {"equivalentLabels": {"const": ["User", "Consumer"]}, "equivalenceNoteDoesNotMakeMixedLabelsConsistent": {"const": true}, "questionTriggersSameTurnNormalization": {"const": true}, "defaultTerm": {"const": "User"}, "distinctRoles": {"const": "never-normalize"}, "firstCorrection": {"type": "object", "additionalProperties": false, "required": ["topicId", "targetId", "operation"], "properties": {"topicId": {"const": "terminology:user-consumer"}, "targetId": {"const": "workflow-diagram"}, "operation": {"const": "replace"}}}, "sameTopicFollowUp": {"type": "object", "additionalProperties": false, "required": ["operation", "reuseLocalBlockId"], "properties": {"operation": {"const": "update"}, "reuseLocalBlockId": {"const": true}}}, "restore": {"type": "object", "additionalProperties": false, "required": ["operation"], "properties": {"operation": {"const": "remove"}}}}},
        "presentationDecision": {"type": "object", "additionalProperties": false, "required": ["alwaysProvideChatAnswer", "assessAnswerAndRequestedRepresentationInPersonalizedUi", "fullyPresent", "missing", "partial", "inconsistent", "explicitNoPageChange", "restore"], "properties": {"alwaysProvideChatAnswer": {"const": true}, "assessAnswerAndRequestedRepresentationInPersonalizedUi": {"const": true}, "fullyPresent": {"type": "object", "additionalProperties": false, "required": ["ordinaryQuestion", "showOrWalkthrough"], "properties": {"ordinaryQuestion": {"const": "chat-only"}, "showOrWalkthrough": {"const": "focus-only"}}}, "missing": {"type": "object", "additionalProperties": false, "required": ["operation", "requestedDiagramAbsent"], "properties": {"operation": {"const": "add"}, "requestedDiagramAbsent": {"const": "missing-representation"}}}, "partial": {"type": "object", "additionalProperties": false, "required": ["sameTopicLocalBlock", "otherwise"], "properties": {"sameTopicLocalBlock": {"const": "update"}, "otherwise": {"const": "add"}}}, "inconsistent": {"type": "object", "additionalProperties": false, "required": ["authoredTarget", "localBlock", "batchAffectedTargets"], "properties": {"authoredTarget": {"const": "replace"}, "localBlock": {"const": "update"}, "batchAffectedTargets": {"const": true}}}, "explicitNoPageChange": {"const": "chat-only"}, "restore": {"const": "remove"}}},
        "continuation": {"type": "object", "additionalProperties": false, "required": ["reuseTopicAndLocalBlock"], "properties": {"reuseTopicAndLocalBlock": {"const": true}}},
        "failure": {"type": "object", "additionalProperties": false, "required": ["applyFailure"], "properties": {"applyFailure": {"const": "honest-acknowledgement-no-false-success"}}},
        "applyHandshake": {"type": "object", "additionalProperties": false, "required": ["required", "nonceReuse", "focusOnlyChangesRevision"], "properties": {"required": {"const": ["requestId", "expectedWorkspaceRevision", "explanationId", "topicId", "operations", "handshake"]}, "nonceReuse": {"const": "same-activation-idempotent-retry-and-ordered-chain-only"}, "focusOnlyChangesRevision": {"const": false}}}
      }
    }
  }
}
