{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrew-veresov.github.io/explain-him/schemas/webmcp-contract.v3.schema.json",
  "title": "Explain Him WebMCP Protocol v3 contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "activation", "contractId", "explanationId", "baseRevision", "workspaceRevision", "repository", "skills", "skillLoadOrder", "skillProof", "agentPolicy", "blockSchema", "handshakeSchema", "targets", "localBlocks", "applyOperations", "authoredLayerMutable", "repositoryAccessViaWebMcp"],
  "properties": {
    "schemaVersion": {"const": "explain-him-webmcp-contract.v3"},
    "protocolVersion": {"const": 3},
    "activation": {"$ref": "#/$defs/activation"},
    "contractId": {"$ref": "#/$defs/contractId"},
    "explanationId": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "baseRevision": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "workspaceRevision": {"type": "integer", "minimum": 0},
    "repository": {"$ref": "#/$defs/repository"},
    "skills": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/skill"}},
    "skillLoadOrder": {"type": "array", "const": ["explain-him", "explain-him-presentation"]},
    "skillProof": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/proof"}},
    "agentPolicy": {"$ref": "#/$defs/agentPolicy"},
    "blockSchema": {"$ref": "#/$defs/schemaLocation"},
    "handshakeSchema": {"$ref": "#/$defs/schemaLocation"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "localBlocks": {"type": "array", "items": {"$ref": "#/$defs/localBlock"}},
    "applyOperations": {"type": "array", "const": ["add", "replace", "update", "remove", "focus"]},
    "authoredLayerMutable": {"const": false},
    "repositoryAccessViaWebMcp": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160},
    "contractId": {"type": "string", "pattern": "^contract-[0-9a-f]{36}$"},
    "activation": {"type": "object", "additionalProperties": false, "required": ["id", "nonce"], "properties": {"id": {"type": "string", "pattern": "^activation-[0-9a-f]{36}$"}, "nonce": {"type": "string", "pattern": "^nonce-[0-9a-f]{36}$"}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["fullName", "url", "skillsCommit"], "properties": {"fullName": {"const": "andrew-veresov/explain-him"}, "url": {"const": "https://github.com/andrew-veresov/explain-him"}, "skillsCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["id", "commit", "sha256"], "properties": {"id": {"type": "string", "enum": ["explain-him", "explain-him-presentation"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "skill": {"type": "object", "additionalProperties": false, "required": ["id", "path", "rawUrl", "commit", "sha256", "responsibility"], "properties": {"id": {"type": "string", "enum": ["explain-him", "explain-him-presentation"]}, "path": {"type": "string", "pattern": "^skills/[A-Za-z0-9._/-]+/SKILL\\.md$"}, "rawUrl": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/andrew-veresov/explain-him/[0-9a-f]{40}/skills/[A-Za-z0-9._/-]+/SKILL\\.md$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "responsibility": {"type": "string", "enum": ["grounding-and-repository-retrieval", "typed-page-presentation-and-guided-focus"]}}},
    "schemaLocation": {"type": "object", "additionalProperties": false, "required": ["path", "url"], "properties": {"path": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._/-]+\\.json$"}, "url": {"type": "string", "pattern": "^/explain-him/schemas/[A-Za-z0-9._/-]+\\.json$"}, "types": {"type": "array", "items": {"enum": ["callout", "comparison", "workflow", "timeline", "diagram"]}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["id", "title", "replaceable", "acceptedTypes"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "title": {"type": "string", "maxLength": 120}, "replaceable": {"type": "boolean"}, "acceptedTypes": {"type": "array", "const": ["callout", "comparison", "workflow", "timeline", "diagram"]}}},
    "localBlock": {"type": "object", "additionalProperties": false, "required": ["id", "topicId", "targetId", "placement", "type", "title", "updatedAt"], "properties": {"id": {"type": "string", "pattern": "^local-[A-Za-z0-9._:-]+$"}, "topicId": {"type": ["string", "null"], "maxLength": 120}, "targetId": {"$ref": "#/$defs/identifier"}, "placement": {"enum": ["after", "replace"]}, "type": {"type": ["string", "null"], "enum": ["callout", "comparison", "workflow", "timeline", "diagram", null]}, "title": {"type": ["string", "null"], "maxLength": 160}, "updatedAt": {"type": ["string", "null"]}}},
    "agentPolicy": {"type": "object", "additionalProperties": false, "required": ["bootstrap", "skillLoading", "presentationDecision", "continuation", "failure", "applyHandshake"], "properties": {"bootstrap": {"type": "object", "additionalProperties": false, "required": ["requiredOnPageActivation", "beforeFirstPageAnswer"], "properties": {"requiredOnPageActivation": {"const": true}, "beforeFirstPageAnswer": {"const": true}}}, "skillLoading": {"type": "object", "additionalProperties": false, "required": ["required", "loadOrder"], "properties": {"required": {"const": true}, "loadOrder": {"type": "array", "const": ["explain-him", "explain-him-presentation"]}}}, "presentationDecision": {"type": "object", "additionalProperties": false, "required": ["alwaysProvideChatAnswer", "assessAnswerAndRequestedRepresentationInPersonalizedUi", "fullyPresent", "missing", "partial", "inconsistent", "explicitNoPageChange", "restore"], "properties": {"alwaysProvideChatAnswer": {"const": true}, "assessAnswerAndRequestedRepresentationInPersonalizedUi": {"const": true}, "fullyPresent": {"type": "object", "additionalProperties": false, "required": ["ordinaryQuestion", "showOrWalkthrough"], "properties": {"ordinaryQuestion": {"const": "chat-only"}, "showOrWalkthrough": {"const": "focus-only"}}}, "missing": {"type": "object", "additionalProperties": false, "required": ["operation", "requestedDiagramAbsent"], "properties": {"operation": {"const": "add"}, "requestedDiagramAbsent": {"const": "missing-representation"}}}, "partial": {"type": "object", "additionalProperties": false, "required": ["sameTopicLocalBlock", "otherwise"], "properties": {"sameTopicLocalBlock": {"const": "update"}, "otherwise": {"const": "add"}}}, "inconsistent": {"type": "object", "additionalProperties": false, "required": ["authoredTarget", "localBlock", "batchAffectedTargets"], "properties": {"authoredTarget": {"const": "replace"}, "localBlock": {"const": "update"}, "batchAffectedTargets": {"const": true}}}, "explicitNoPageChange": {"const": "chat-only"}, "restore": {"const": "remove"}}}, "continuation": {"type": "object", "additionalProperties": false, "required": ["reuseTopicAndLocalBlock"], "properties": {"reuseTopicAndLocalBlock": {"const": true}}}, "failure": {"type": "object", "additionalProperties": false, "required": ["applyFailure"], "properties": {"applyFailure": {"const": "honest-acknowledgement-no-false-success"}}}, "applyHandshake": {"type": "object", "additionalProperties": false, "required": ["required", "nonceReuse", "focusOnlyChangesRevision"], "properties": {"required": {"type": "array", "const": ["requestId", "expectedWorkspaceRevision", "explanationId", "topicId", "operations", "handshake"]}, "nonceReuse": {"const": "same-activation-idempotent-retry-and-ordered-chain-only"}, "focusOnlyChangesRevision": {"const": false}}}}}
  }
}
